# Local dev env for the Synchronize fork of Dograh. Copy to $SYNC_VOICE_DEV_DIR/api.env and replace the two secrets.
# Nothing here is a production setting. See synchronize/README.md for why each switch is set.
ENVIRONMENT="local"
LOG_LEVEL="INFO"
ENABLE_SIGNUP="true"
AUTH_PROVIDER="local"
DEPLOYMENT_MODE="oss"
OSS_JWT_SECRET="replace-with-a-random-string"
DOGRAH_DEVOPS_SECRET="replace-with-another-random-string"

# Ports are remapped off the host defaults (other containers use 5432/6379/8000).
UVICORN_BASE_PORT=56800
BACKEND_API_ENDPOINT="http://127.0.0.1:56800"
UI_APP_URL="http://127.0.0.1:56300"
DATABASE_URL="postgresql+asyncpg://postgres:postgres@127.0.0.1:56432/postgres"
REDIS_URL="redis://:redissecret@127.0.0.1:56379"

# Dograh's hosted MPS has no off switch, only a base URL. A closed loopback port makes every MPS call fail fast.
MPS_API_URL="http://127.0.0.1:1"

# Telemetry: Sentry only starts when SENTRY_DSN is set, PostHog only when POSTHOG_API_KEY is set, Langfuse only when
# LANGFUSE_* are set. Leave all of them unset. ENABLE_TELEMETRY=false is belt and braces for the OSS Sentry gate.
ENABLE_TELEMETRY="false"

# Storage: the bundled MinIO (public bucket, unsigned URLs: local dev only).
ENABLE_AWS_S3="false"
MINIO_ENDPOINT=127.0.0.1:56900
MINIO_PUBLIC_ENDPOINT=http://127.0.0.1:56900
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=voice-audio
MINIO_SECURE=false
ENABLE_COTURN=false
ENABLE_PROMETHEUS_METRICS=false
